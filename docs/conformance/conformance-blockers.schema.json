{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kastalien-Research/mcp-effect-sdk/blob/main/docs/conformance/conformance-blockers.schema.json",
  "title": "mcp-effect-sdk adjudicated conformance blockers",
  "description": "Conformance checks that fail because the pinned evaluator contradicts the pinned normative schema, not because this SDK is non-conforming. Every entry must cite the normative clause it relies on and name a reproducer test that proves the contradiction. This is deliberately not an expected-failures allowlist: an entry only suppresses a failure while its reproducer passes and the harness version is unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "harness",
    "specVersion",
    "normativeSource",
    "reproducerCommand",
    "analysis",
    "blocked"
  ],
  "properties": {
    "$schema": { "const": "./conformance-blockers.schema.json" },
    "schemaVersion": { "const": 1 },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "revision"],
      "properties": {
        "package": { "const": "@modelcontextprotocol/conformance" },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "specVersion": { "const": "2026-07-28" },
    "normativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "vendoredPath"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "vendoredPath": { "type": "string", "pattern": "^sources/vendor/" }
      }
    },
    "reproducerCommand": { "const": "pnpm run test:conformance-contradictions" },
    "analysis": { "type": "string", "minLength": 1 },
    "blocked": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/blockedCheck" }
    }
  },
  "$defs": {
    "blockedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "scenario",
        "normativeClause",
        "harnessExpectation",
        "reproducerTest",
        "unblockCondition"
      ],
      "properties": {
        "checkId": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "normativeClause": {
          "type": "string",
          "minLength": 40,
          "description": "What the pinned normative schema actually says. Long enough to be a real citation rather than a label."
        },
        "harnessExpectation": {
          "type": "string",
          "minLength": 20,
          "description": "What the evaluator asserts instead, so the contradiction is stated in the ledger itself."
        },
        "reproducerTest": {
          "type": "string",
          "minLength": 1,
          "description": "Exact test name in test/conformance/alpha9-contradictions.test.mjs that proves this contradiction."
        },
        "unblockCondition": { "type": "string", "minLength": 20 }
      }
    }
  }
}

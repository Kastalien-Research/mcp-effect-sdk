{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kastalien-Research/mcp-effect-sdk/blob/main/docs/conformance/feature-coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "protocolVersion", "authority", "roleBoundaries", "features", "excluded"],
  "properties": {
    "$schema": { "const": "./feature-coverage.schema.json" },
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": "2026-07-28" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "capabilities", "policy"],
      "properties": {
        "protocol": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "format": "uri" }
      }
    },
    "roleBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizationServer", "experimentalCapabilities"],
      "properties": {
        "authorizationServer": { "const": "not-claimed" },
        "experimentalCapabilities": { "const": "excluded-by-tier-policy" }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    },
    "excluded": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string", "minLength": 1 }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "protocolIdentifier", "status", "api", "documentation", "example", "tests"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "client-request",
            "client-notification",
            "server-notification",
            "client-capability",
            "server-capability",
            "transport",
            "authorization",
            "deprecated"
          ]
        },
        "protocolIdentifier": { "type": "string", "minLength": 1 },
        "status": { "const": "supported" },
        "api": { "$ref": "#/$defs/reference" },
        "documentation": { "$ref": "#/$defs/reference" },
        "example": { "$ref": "#/$defs/reference" },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "protocolIdentifier", "classification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["client-capability", "server-capability"] },
        "protocolIdentifier": { "const": "experimental" },
        "classification": { "const": "official-tier-experimental" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kastalien-Research/mcp-effect-sdk/blob/main/docs/maintenance/sla-ledger.schema.json",
  "title": "mcp-effect-sdk maintenance SLA evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyEffectiveDate", "entries"],
  "properties": {
    "$schema": {
      "const": "./sla-ledger.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "policyEffectiveDate": {
      "type": "string",
      "const": "2026-06-23",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "supportStats": {
      "type": "object",
      "description": "The measure SEP-1730 actually validates against: 'github stats on issues'. Computed over the whole issue history, independent of the policy window, because upstream does not apply our window. Kept alongside the per-incident ledger rather than replacing it.",
      "additionalProperties": false,
      "required": [
        "measure",
        "source",
        "collectedAt",
        "issues",
        "addressed",
        "unaddressed",
        "medianResponseDays",
        "maxResponseDays",
        "stillOpenAndUnaddressed"
      ],
      "properties": {
        "measure": {
          "type": "string",
          "minLength": 20
        },
        "source": {
          "type": "string",
          "pattern": "^sources/vendor/"
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "issues": {
          "type": "integer",
          "minimum": 0
        },
        "addressed": {
          "type": "integer",
          "minimum": 0
        },
        "unaddressed": {
          "type": "integer",
          "minimum": 0
        },
        "medianResponseDays": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "maxResponseDays": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "stillOpenAndUnaddressed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "relegationHorizon": {
      "type": "array",
      "description": "SEP-1730 relegates an SDK whose issues go unaddressed for two months. Recorded here so an offline gate can surface the deadline without network access on every verify.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "url", "openedAt", "relegationAt", "daysRemaining"],
        "properties": {
          "issue": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          },
          "relegationAt": {
            "type": "string",
            "format": "date-time"
          },
          "daysRemaining": {
            "type": "integer"
          }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "collection": {
                "$ref": "#/$defs/commandCollection"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "object",
                "properties": {
                  "exitCode": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "$ref": "#/$defs/manualCollection"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "object",
                "properties": {
                  "exitCode": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ],
      "required": [
        "id",
        "eventType",
        "issueOrEvent",
        "openedAt",
        "deadlineAt",
        "observedAt",
        "response",
        "collection",
        "outcome",
        "requirementIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "eventType": {
          "enum": ["issue-triage", "p0-resolution", "security-resolution"]
        },
        "issueOrEvent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "url"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "openedAt": {
          "type": "string",
          "format": "date-time"
        },
        "deadlineAt": {
          "type": "string",
          "format": "date-time"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "observedAt"],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "observedAt": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "collection": {
          "oneOf": [
            {
              "$ref": "#/$defs/commandCollection"
            },
            {
              "$ref": "#/$defs/manualCollection"
            }
          ]
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "exitCode", "details"],
          "properties": {
            "status": {
              "enum": ["met", "missed", "pending", "excluded"]
            },
            "exitCode": {
              "type": ["integer", "null"]
            },
            "details": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^GR-[A-Z]+-[0-9]{3}$"
          },
          "contains": {
            "const": "GR-TIER-002"
          }
        }
      }
    },
    "commandCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "collectedAt"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "manualCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status", "collectedAt"],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}

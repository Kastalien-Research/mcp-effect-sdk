{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kastalien-Research/mcp-effect-sdk/blob/main/docs/agent-evidence/agent-eval.schema.json",
  "title": "mcp-effect-sdk agent-in-the-loop eval evidence",
  "description": "Machine-readable results of running examples/agent-facing-proof-servers.ts against real models through the MCP dispatcher. The readiness checker's generic envelope validation would accept a six-field stub, so this schema exists to make GR-AGENT-001/002/003 evidence falsifiable: it demands the model identities, per-trial transcripts, per-scenario pass rates, and the affordance-path counts that a real run produces and a stub cannot.",
  "type": "object",
  "required": ["evidenceKind", "timestamp", "command", "exitCode", "requirementIds", "suite", "summary", "scenarios"],
  "properties": {
    "evidenceKind": {
      "const": "agent-eval-result"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "const": "pnpm run eval:agent"
    },
    "exitCode": {
      "type": "integer",
      "enum": [0, 1]
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^GR-AGENT-00[123]$"
      }
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "description",
        "sdkCommit",
        "models",
        "trialsPerScenarioPerModel",
        "scenarioCount",
        "trials",
        "passed",
        "passRate",
        "affordancePathCoverage",
        "thresholdMet",
        "primaryModel",
        "threshold",
        "gaps"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 10
        },
        "sdkCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Evidence is only meaningful against the affordance surface it was measured on."
        },
        "models": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^claude-"
          },
          "description": "At least two models. A salience claim resting on one strong model is not a salience claim; the weaker model is the floor."
        },
        "trialsPerScenarioPerModel": {
          "type": "integer",
          "minimum": 1,
          "description": "Models are non-deterministic, so a pass rate is the honest unit rather than a single sample."
        },
        "scenarioCount": {
          "type": "integer",
          "minimum": 1
        },
        "trials": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "passRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "affordancePathCoverage": {
          "$ref": "#/$defs/pathCoverage"
        },
        "thresholdMet": {
          "type": "boolean"
        },
        "primaryModel": {
          "type": "string",
          "pattern": "^claude-",
          "description": "The model whose results carry the claim; a failure here is a surface gap, not a model gap."
        },
        "threshold": {
          "type": "object",
          "description": "A structured bar rather than a flat percentage: a percentage across models measures model capability, while the requirement is about the affordance surface.",
          "required": [
            "primaryModelPassesEveryScenario",
            "everyScenarioSolvableByEveryModel",
            "allAffordancePathsExercised"
          ],
          "properties": {
            "primaryModelPassesEveryScenario": {
              "type": "boolean"
            },
            "everyScenarioSolvableByEveryModel": {
              "type": "boolean"
            },
            "allAffordancePathsExercised": {
              "type": "boolean"
            }
          }
        },
        "gaps": {
          "type": "array",
          "description": "Every model/scenario pair that did not pass all trials, with the distinct failure reasons. Required so a passing artifact still carries its own caveats rather than rounding them away.",
          "items": {
            "type": "object",
            "required": ["scenario", "model", "passed", "trials", "passRate", "reasons"],
            "properties": {
              "scenario": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "trials": {
                "type": "integer",
                "minimum": 1
              },
              "passRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "pathCoverage": {
      "type": "object",
      "description": "The five paths GR-AGENT-003 names. Recorded for every artifact so the observability claim is measured, not asserted.",
      "required": ["offered", "selected", "ignored", "retried", "failed"],
      "properties": {
        "offered": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "ignored": {
          "type": "integer",
          "minimum": 0
        },
        "retried": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "server", "trials", "passed", "passRate", "byModel", "results"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "server": {
          "type": "string",
          "pattern": "Server$",
          "description": "The proof server exported from examples/agent-facing-proof-servers.ts."
        },
        "trials": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "passRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "byModel": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "object",
            "required": ["trials", "passed", "passRate"],
            "properties": {
              "trials": {
                "type": "integer",
                "minimum": 1
              },
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "passRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trial"
          }
        }
      }
    },
    "trial": {
      "type": "object",
      "required": ["trial", "model", "passed", "reason", "iterations", "affordances", "transcript", "usage"],
      "properties": {
        "trial": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "type": "string",
          "pattern": "^claude-"
        },
        "passed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "description": "Why the trial passed or failed, derived from the fixture's own declared criteria."
        },
        "iterations": {
          "type": "integer",
          "minimum": 0
        },
        "stopReason": {
          "type": ["string", "null"]
        },
        "affordances": {
          "type": "object",
          "required": ["offered", "selected", "ignored", "retried", "failed", "counts"],
          "properties": {
            "offered": {
              "type": "array",
              "minItems": 1
            },
            "selected": {
              "type": "array"
            },
            "ignored": {
              "type": "array"
            },
            "retried": {
              "type": "array"
            },
            "failed": {
              "type": "array"
            },
            "counts": {
              "$ref": "#/$defs/pathCoverage"
            }
          }
        },
        "traceEvents": {
          "type": ["array", "null"]
        },
        "transcript": {
          "type": "array",
          "description": "The golden transcript GR-AGENT-002 asks for. Present even on failure, so a regression can be read rather than guessed at.",
          "items": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "enum": ["assistant", "tool_use"]
              },
              "text": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "input": {}
            }
          }
        },
        "usage": {
          "type": "object",
          "required": ["inputTokens", "outputTokens"],
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "cacheReadTokens": {
              "type": "integer",
              "minimum": 0
            },
            "cacheCreationTokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}

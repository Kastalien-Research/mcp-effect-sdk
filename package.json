{
  "name": "mcp-effect-sdk",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "description": "Effect-native Model Context Protocol SDK for TypeScript, supporting MCP 2026-07-28 and 2025-11-25.",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./auth/client": {
      "import": "./dist/auth/client.js",
      "types": "./dist/auth/client.d.ts"
    },
    "./auth/protected-resource": {
      "import": "./dist/auth/protected-resource.js",
      "types": "./dist/auth/protected-resource.d.ts"
    },
    "./integrations/effect-platform": {
      "import": "./dist/integrations/EffectPlatform.js",
      "types": "./dist/integrations/EffectPlatform.d.ts"
    },
    "./transport/stdio": {
      "import": "./dist/transport/stdio.js",
      "types": "./dist/transport/stdio.d.ts"
    },
    "./transport/http": {
      "import": "./dist/transport/http.js",
      "types": "./dist/transport/http.d.ts"
    },
    "./deprecated": {
      "import": "./dist/deprecated.js",
      "types": "./dist/deprecated.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./protocol/2026-07-28": {
      "import": "./dist/protocol/2026-07-28.js",
      "types": "./dist/protocol/2026-07-28.d.ts"
    },
    "./protocol/2025-11-25": {
      "import": "./dist/protocol/2025-11-25.js",
      "types": "./dist/protocol/2025-11-25.d.ts"
    },
    "./legacy/client": {
      "import": "./dist/legacy/client.js",
      "types": "./dist/legacy/client.d.ts"
    },
    "./legacy/server": {
      "import": "./dist/legacy/server.js",
      "types": "./dist/legacy/server.d.ts"
    },
    "./legacy/transport/stdio": {
      "import": "./dist/legacy/stdio.js",
      "types": "./dist/legacy/stdio.d.ts"
    },
    "./experimental/tasks": {
      "import": "./dist/experimental/tasks.js",
      "types": "./dist/experimental/tasks.d.ts"
    },
    "./legacy/tasks": {
      "import": "./dist/legacy/tasks.js",
      "types": "./dist/legacy/tasks.d.ts"
    },
    "./legacy/transport/http": {
      "import": "./dist/legacy/http.js",
      "types": "./dist/legacy/http.d.ts"
    },
    "./legacy/resources": {
      "import": "./dist/legacy/resources.js",
      "types": "./dist/legacy/resources.d.ts"
    },
    "./legacy/logging": {
      "import": "./dist/legacy/logging.js",
      "types": "./dist/legacy/logging.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc -p examples/tsconfig.json",
    "build:sdk": "tsc",
    "build:examples": "tsc -p examples/tsconfig.json",
    "check:conformance-evidence": "node scripts/check-conformance-evidence.mjs",
    "check:agent-evidence": "node scripts/run-script-entrypoint.mjs scripts/check-agent-evidence.mjs check:agent-evidence",
    "check:extensions": "node scripts/check-extension-boundary.mjs",
    "check:effect-foundation": "node scripts/check-effect-foundation.mjs",
    "check:effect-lsp": "node scripts/check-effect-lsp.mjs",
    "check:generated": "node scripts/generate-mcp.mjs --protocol-version 2026-07-28 --check && node scripts/generate-mcp.mjs --protocol-version 2025-11-25 --check",
    "check:generated-protocol-surfaces": "node scripts/run-script-entrypoint.mjs scripts/check-generated-protocol-surfaces.mjs check:generated-protocol-surfaces",
    "check:schema-fixtures": "node scripts/run-script-entrypoint.mjs scripts/check-generated-schema-fixtures.mjs check:schema-fixtures",
    "check:historical-mcp": "node scripts/check-historical-mcp-cleanup.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:observability-coverage": "node scripts/check-observability-coverage.mjs",
    "check:release-artifact": "node scripts/check-release-artifact.mjs",
    "check:sdk-readiness": "node scripts/check-sdk-readiness-requirements.mjs",
    "check:sdk-runtime": "node scripts/check-sdk-runtime.mjs",
    "check:tier-protocol-features": "node scripts/check-tier-protocol-features.mjs",
    "check:ts-sdk-parity": "node scripts/check-ts-sdk-parity.mjs",
    "check:sdk-workflow": "node scripts/check-sdk-workflow.mjs",
    "check:tasks": "node scripts/check-task-runtime.mjs",
    "check:tier-operations": "node scripts/check-tier-operations.mjs",
    "check:tier-relegation": "node scripts/run-script-entrypoint.mjs scripts/check-tier-relegation.mjs check:tier-relegation",
    "check:type-fixtures": "node scripts/check-type-fixtures.mjs",
    "test:effect-foundation": "node --test test/foundation/effect-foundation.test.mjs",
    "test:script-libraries": "node --test test/foundation/script-libraries.test.mjs",
    "test:regressions": "node --test test/foundation/wp2-review-regressions.test.mjs",
    "test:schema-codecs": "pnpm run build && node --test test/generation/wp3-schema-codecs.test.mjs",
    "test:protocol-metadata": "pnpm run build && node --test test/generation/wp3-protocol-metadata.test.mjs",
    "test:runtime-2026-07-28": "pnpm run build && node --test test/server/runtime-2026-07-28-compliance.test.mjs",
    "test:wire": "pnpm run build && node scripts/run-wire-suite.mjs",
    "test:dispatcher": "pnpm run build && node scripts/run-dispatcher-suite.mjs",
    "test:stdio": "pnpm run build && node scripts/run-stdio-suite.mjs",
    "test:http-metadata": "pnpm run build && node scripts/run-http-metadata-suite.mjs",
    "test:http-client": "pnpm run build && node scripts/run-http-client-suite.mjs",
    "test:http-server": "pnpm run build && node scripts/run-http-server-suite.mjs",
    "test:http": "pnpm run build && node scripts/run-http-suite.mjs",
    "test:transports": "pnpm run build && node scripts/run-transports-suite.mjs",
    "test:results": "pnpm run build && node --test test/core/wp5-result-metadata.test.mjs test/client/wp5-result-decoding.test.mjs && pnpm exec tsc -p test/types/wp5-core-result/tsconfig.json --noEmit",
    "test:construction": "pnpm run build && node --test test/client/wp5b-client-construction.test.mjs test/server/wp5b-server-construction.test.mjs && pnpm exec tsc -p test/types/wp5b-client-construction/tsconfig.json --noEmit && pnpm exec tsc -p test/types/wp5b-server-construction/tsconfig.json --noEmit",
    "test:json-schema": "pnpm run build && node --test test/schema/wp5c-json-schema.test.mjs test/server/wp5c-tool-output-schema.test.mjs && pnpm exec tsc -p test/types/wp5c-json-schema/tsconfig.json --noEmit",
    "test:pagination-cache": "pnpm run build && node --test test/server/wp5d-pagination.test.mjs test/client/wp5d-cache.test.mjs test/http/wp5d-http-catalog.test.mjs && pnpm exec tsc -p test/types/wp5d-pagination-cache/tsconfig.json --noEmit",
    "test:progress-cancellation": "pnpm run build && node --test test/server/wp5e-progress-cancellation.test.mjs test/client/wp5e-progress-cancellation.test.mjs && pnpm exec tsc -p test/types/wp5e-progress-cancellation/tsconfig.json --noEmit",
    "test:input-required": "pnpm run build && node --test test/client/wp5f-input-required.test.mjs test/server/wp5f-input-required.test.mjs test/security/wp5f-request-state.test.mjs && pnpm exec tsc -p test/types/wp5f-input-required/tsconfig.json --noEmit && pnpm exec tsc -p test/types/wp5f-request-state/tsconfig.json --noEmit",
    "test:subscriptions": "pnpm run build && node --test test/client/wp5g-subscription.test.mjs && pnpm exec tsc -p test/types/wp5g-subscription/tsconfig.json --noEmit",
    "test:deprecated-boundary": "pnpm run build && node --test test/packaging/wp5h-deprecated-boundary.test.mjs",
    "test:examples": "pnpm run build && node --test test/packaging/wp5h-examples.test.mjs",
    "test:packaging": "pnpm run build && node --test test/packaging/wp5b-core-subpaths.test.mjs test/packaging/legacy-2025-subpaths.test.mjs test/packaging/wp5h-governance.test.mjs test/packaging/wp5h-packed-core-consumer.test.mjs test/packaging/release-contract.test.mjs && pnpm exec tsc -p test/types/wp5b-core-subpaths/tsconfig.json --noEmit && pnpm exec tsc -p test/types/wp5-core-public/tsconfig.json --noEmit",
    "test:core": "pnpm run test:results && pnpm run test:construction && pnpm run test:json-schema && pnpm run test:pagination-cache && pnpm run test:progress-cancellation && pnpm run test:input-required && pnpm run test:subscriptions && pnpm run test:deprecated-boundary && pnpm run test:examples && pnpm run test:packaging",
    "test:auth-client": "pnpm run build && node --test test/auth/wp6-client-runtime.test.mjs test/auth/wp6b-client-boundary.test.mjs test/auth/wp6c-discovery.test.mjs test/auth/wp6c-registration.test.mjs test/auth/wp6c-scopes.test.mjs test/auth/wp6c-security.test.mjs test/auth/wp6d-client-token.test.mjs test/auth/wp6d-client-transaction.test.mjs",
    "test:auth-protected-resource": "pnpm run build && node --test test/auth/wp6b-protected-resource-boundary.test.mjs",
    "test:auth-http": "pnpm run build && node --test test/http/wp6-http-client-auth.test.mjs test/http/wp6-http-protected-resource.test.mjs",
    "test:auth-types": "pnpm exec tsc -p test/types/wp6-client-runtime/tsconfig.json --noEmit && pnpm exec tsc -p test/types/wp6b-auth-public/tsconfig.json --noEmit && pnpm exec tsc -p test/types/wp6-auth-protected-resource/tsconfig.json --noEmit",
    "test:auth-packaging": "pnpm run build && node --test test/packaging/wp6b-auth-subpaths.test.mjs test/packaging/wp6-auth-examples.test.mjs test/packaging/wp6-auth-core-governance.test.mjs",
    "test:auth-governance": "pnpm run build && node --test test/packaging/wp6-auth-governance.test.mjs",
    "test:auth": "pnpm run test:auth-client && pnpm run test:auth-protected-resource && pnpm run test:auth-http && pnpm run test:auth-types && pnpm run test:auth-packaging && pnpm run test:auth-governance",
    "test:tasks-schema": "pnpm run build && node --test test/schema/wp7a-tasks-schema.test.mjs test/packaging/wp7a-tasks-boundary.test.mjs && pnpm exec tsc -p test/types/wp7a-tasks/tsconfig.json --noEmit",
    "conformance:run": "pnpm run build && node scripts/run-conformance-suite.mjs",
    "e2e:2026-07-28": "pnpm run build && node scripts/run-2026-07-28-e2e.mjs",
    "conformance:client": "pnpm run build && node scripts/run-conformance-client.mjs",
    "conformance:client:2025-11-25": "pnpm run build && node scripts/run-conformance-client-2025.mjs",
    "conformance:client-auth": "pnpm run build && node scripts/run-conformance-client-auth.mjs",
    "conformance:authorization": "node scripts/run-conformance-authorization.mjs",
    "conformance:server": "pnpm run build && node scripts/run-conformance-server.mjs",
    "generate:mcp": "node scripts/generate-mcp.mjs --protocol-version 2026-07-28 && node scripts/generate-mcp.mjs --protocol-version 2025-11-25",
    "generate:tier-maintenance": "node scripts/generate-tier-maintenance.mjs",
    "generate:docs-coverage": "node scripts/generate-docs-coverage.mjs",
    "generate:observability-inventory": "node scripts/generate-observability-inventory.mjs",
    "generate:release-provenance": "node scripts/generate-release-provenance.mjs",
    "eval:agent": "pnpm run build && node scripts/run-agent-evals.mjs",
    "report:conformance": "node scripts/report-conformance-failures.mjs",
    "sources:check": "node scripts/check-source-snapshots.mjs",
    "sources:refresh": "node scripts/refresh-source-snapshot.mjs",
    "test:unit": "node scripts/run-readiness-test-suite.mjs unit",
    "test:integration": "node scripts/run-readiness-test-suite.mjs integration",
    "test:source-refresh": "node --test test/source-refresh.integration.test.mjs",
    "test:tier-operations": "node --test test/operations/tier-operations.test.mjs",
    "test:e2e": "node scripts/run-readiness-test-suite.mjs e2e",
    "verify:conformance": "node scripts/verify-conformance.mjs",
    "verify:published-package": "node scripts/run-script-entrypoint.mjs scripts/verify-published-package.mjs verify:published-package",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepublishOnly": "node scripts/release-via-tag.mjs",
    "prepack": "pnpm run build",
    "release": "node scripts/release-via-tag.mjs",
    "test": "pnpm run verify",
    "verify": "node scripts/verify.mjs",
    "effect:strict:dev-processes": "effect-language-service diagnostics --project dev-processes/tsconfig.json --format text --severity error,warning --strict",
    "effect:diagnostics": "effect-language-service diagnostics --project tsconfig.json --format text",
    "effect:file": "effect-language-service diagnostics --format text --file",
    "effect:strict": "effect-language-service diagnostics --project tsconfig.json --format text --severity error,warning --strict",
    "effect:codegen": "effect-language-service codegen --project tsconfig.json --verbose",
    "effect:overview": "effect-language-service overview --project tsconfig.json --max-symbol-depth 1",
    "effect:quickfixes": "effect-language-service quickfixes --project tsconfig.json",
    "effect:layerinfo": "effect-language-service layerinfo",
    "effect:vendor": "node scripts/vendor-effect.mjs",
    "effect:vendor:check": "node scripts/vendor-effect.mjs --check",
    "test:observability": "pnpm run build && node --test test/observability/observability-contracts.test.mjs test/observability/observability-artifacts.test.mjs test/observability/observability-coverage.test.mjs test/observability/example-entrypoint-boundaries.test.mjs test/observability/runtime-layer-and-observability.test.mjs test/observability/spans.test.mjs test/observability/spans-contract.test.mjs test/observability/visual-effect-script-contracts.test.mjs",
    "check:legacy-protocol-surfaces": "pnpm run build:sdk && node scripts/run-script-entrypoint.mjs scripts/check-legacy-protocol-surfaces.mjs check:legacy-protocol-surfaces",
    "test:legacy": "pnpm run build:sdk && node --test test/legacy/*.test.mjs",
    "e2e:2025-11-25": "pnpm run test:legacy",
    "conformance:2025-11-25": "pnpm run build && node scripts/run-conformance-2025.mjs",
    "conformance:server:2025-11-25": "pnpm run build && node dist/examples/everything-server-2025.js"
  },
  "keywords": [
    "modelcontextprotocol",
    "mcp",
    "effect",
    "effect-ts",
    "sdk",
    "typescript"
  ],
  "author": "Kastalien Research",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kastalien-Research/mcp-effect-sdk.git"
  },
  "homepage": "https://github.com/Kastalien-Research/mcp-effect-sdk#readme",
  "bugs": "https://github.com/Kastalien-Research/mcp-effect-sdk/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "!dist/examples",
    "README.md",
    "CHANGELOG.md",
    "DEPENDENCY_POLICY.md",
    "MAINTENANCE.md",
    "VERSIONING.md",
    "ROADMAP.md",
    "SECURITY.md",
    "scripts/release-via-tag.mjs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "peerDependencies": {
    "@effect/platform": "^0.97.0",
    "effect": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "@effect/rpc": "0.76.0"
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@effect/experimental": "0.61.0",
    "@effect/language-service": "^0.87.1",
    "@effect/platform-node": "0.108.0",
    "@effect/rpc": "0.76.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "ajv-formats": "3.0.1",
    "effect": "3.22.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^17.8.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}

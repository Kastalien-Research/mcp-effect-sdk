# Read-only clone of the official SDK, kept as a parity oracle
typescript-sdk

# Read-only Effect upstream source, pinned for agent reference. Not ours to
# format; reformatting would also defeat diffing against upstream.
repos

# Vendored upstream inputs. `.gitattributes` marks these `-whitespace` because
# the source snapshots are hash-locked to `sources/manifest.json`; reformatting
# them breaks `pnpm run sources:check`.
sources/vendor

# Generated from the pinned MCP schema by `pnpm run generate:mcp`. The
# generator owns the formatting, and `check:generated` diffs it byte-for-byte.
src/generated

# Written by `pnpm run eval:agent`. The generator emits these atomically and
# `check:agent-evidence` validates them; reformatting would break byte-identity
# with what the generator writes. The hand-written schema and README are not
# ignored.
docs/agent-evidence/salience-audit.json
docs/agent-evidence/golden-transcripts.json
docs/agent-evidence/affordance-observability.json

